# Copy to backend/.env and fill in. Only Tautulli is needed to run the probe.

TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_API_KEY=
# TAUTULLI_VERIFY_SSL=true

# Where the app's own SQLite, mmdb files and snapshots live.
# Unraid: /mnt/user/appdata/cartographarr, mounted at /data in the container.
DATA_DIR=./data

# auto = probe get_history for machine_id and pick. Set explicitly only to
# override what scripts/probe_source.py decided.
SOURCE_MODE=auto

# Only if the probe says SOURCE_MODE=db. Read-only bind-mount of Tautulli's
# config dir — the DB is snapshotted out of here, never opened in place.
# TAUTULLI_DB_PATH=/tautulli-config

# GeoLite2 City + ASN. Free MaxMind account.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
